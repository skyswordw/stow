<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Only files and folders people choose (Open panel, drag and drop). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remembers a folder someone granted once (/Applications, ~/Library/Fonts) as a security-scoped bookmark. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.executable</key>
	<true/>
	<!-- Shared with StowFinderSync for the Finder hand-off mailbox (#32). Ad-hoc builds
	     still fall back to a private pasteboard because macOS only opens the group to
	     Team-signed binaries; see Handoff/Handoff.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>YNQ2233752.app.stow.Stow</string>
	</array>
	<!-- Sparkle (#35): talks to its installer, which runs outside the sandbox. Xcode expands the
	     bundle identifier (app.stow.Stow-spks / -spki). No network entitlement: Sparkle's
	     downloader service fetches the appcast and the update. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
</dict>
</plist>

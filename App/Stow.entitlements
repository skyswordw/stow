<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Only files and folders people choose (Open panel, drag and drop). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remembers a folder someone granted once (/Applications, ~/Library/Fonts) as a security-scoped bookmark. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<key>com.apple.security.files.user-selected.executable</key>
	<true/>
</dict>
</plist>

            "value": "矢量图像"
          }
        }
      }
    },
    "Verify": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证"
          }
        }
      }
    },
    "Version %@ moves to the Trash and version %@ takes its place.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %1$@ 将移到废纸篓，并由版本 %2$@ 替换。"

      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于"
          }
        }
      },
      "comment": "Connector in the interactive packing sentence, before its intended audience."
    },
    "in 100 MB parts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分为 100 MB 的分卷"
          }

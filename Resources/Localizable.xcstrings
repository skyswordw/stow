          }
        }
      }
    },
    "Stop — nothing is left half-extracted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止，不留下未完成的解压缩文件"
          }
        }
      }
    },
    "Stop — nothing is left half-written": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止，不留下未完成的文件"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        }
      }
    },
    "Store": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅存储"
          }
        }
      },
      "comment": "Compression level: save data without compression."
    },
    "Stow": {
      "shouldTranslate": false
    },
    "Stow can only write in folders you allow. Choose Allow to let Stow extract “%@” here — and next time, extract anything in this folder without asking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 只能写入你允许的文件夹。选择“允许”以在此解压缩“%@”，之后在此文件夹中解压缩时无需再次询问。"
          }
        }
      }
    },
    "Stow can only write in folders you allow. Choose Allow to let Stow save the archive here — and next time, compress anything in this folder without asking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 只能写入你允许的文件夹。选择“允许”以在此存储压缩包，之后在此文件夹中压缩时无需再次询问。"
          }
        }
      }
    },
    "Stow can’t read this disk image’s format. Finder may still be able to open it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 无法读取此磁盘映像格式。你可以尝试在访达中打开。"
          }
        }
      }
    },
    "Stow didn’t receive any files.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 未收到任何文件。"
          }
        }
      }
    },
    "Stow inspects every archive before anything touches your disk.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在写入磁盘之前，Stow 会先检查每个压缩包。"
          }
        }
      }
    },
    "Stow is sandboxed. It asks once before the first install into a folder and remembers only that folder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 在沙盒中运行。首次安装到文件夹前会询问一次，并仅记住该文件夹的权限。"
          }
        }
      }
    },
    "Stow is sandboxed: it only reads and writes where you allow it. No Full Disk Access needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 在沙盒中运行，只会读写你允许的位置，无需完全磁盘访问权限。"
          }
        }
      }
    },
    "Stow keeps it only while this archive is open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 仅在此压缩包打开期间保留密码。"
          }
        }
      }
    },
    "Stow keeps running for Finder and Services actions. Open Stow from Finder or Spotlight to bring it back.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 会继续运行，以响应访达和服务操作。可从访达或聚焦打开 Stow，再次显示窗口。"
          }
        }
      }
    },
    "Stow opened the new archive and checked every file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 已打开新压缩包并检查所有文件"
          }
        }
      }
    },
    "Stow opens archives up to %lld levels deep.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 最多可打开 %lld 层嵌套的压缩包。"
          }
        }
      }
    },
    "Stow opens quietly when you log in, so Finder actions start instantly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 会在你登录时于后台打开，以便立即响应访达操作。"
          }
        }
      }
    },
    "Stow opens when you use it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 会在你使用时打开。"
          }
        }
      }
    },
    "Stow’s archive engine is missing. Reinstall Stow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 的压缩引擎缺失。请重新安装 Stow。"
          }
        }
      }
    },
    "Stow’s archive engine is out of date. Reinstall Stow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 的压缩引擎版本过旧。请重新安装 Stow。"
          }
        }
      }
    },
    "Stow’s archive engine stopped unexpectedly.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 的压缩引擎意外停止。"
          }
        }
      }
    },
    "Suggest": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成建议密码"
          }
        }
      }

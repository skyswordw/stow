        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟硬盘"
          }
        }
      }
    },
    "Visible passwords support Chinese and Japanese input methods. You can hide a password in the password sheet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示密码时可使用中文和日文输入法。你可以在密码窗口中隐藏密码。"

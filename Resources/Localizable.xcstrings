            "state": "translated",
            "value": "Windows 安装器"
          }
        }
      }
    },
    "Windows’ built-in ZIP support can’t always read AES-encrypted ZIPs. Suggest 7-Zip to the recipient.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows 内置的 ZIP 功能不一定能读取 AES 加密的 ZIP。建议收件人使用 7-Zip。"
          }
        }
      }
    },
    "With a password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用密码"
          }
        }
      }
    },
    "Without a password": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不使用密码"
          }
        }
      }
    },
    "Without the password, nobody can see what’s inside.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有密码就无法查看内部内容。"

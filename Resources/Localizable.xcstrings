        }
      }
    },
    "Waiting": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待中"
          }
        }
      }
    },
    "Welcome to Stow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 Stow"
          }
        }
      }
    },
    "Western (DOS 437)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "西欧语言（DOS 437）"
          }
        }
      }
    },
    "Western (DOS 850)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "西欧语言（DOS 850）"
          }
        }
      }
    },
    "Western (Windows-1252)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "西欧语言（Windows-1252）"
          }
        }
      }
    },
    "What Stow does": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stow 能做什么"
          }
        }
      }
    },
    "When something is already there": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

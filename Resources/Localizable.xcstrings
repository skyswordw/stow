{
  "sourceLanguage": "en",
  "strings": {
    " Install it anyway?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 仍要安装吗？"
          }
        }
      }
    },
    " in %lld parts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，共 %lld 个分卷"
          }
        }
      }
    },
    " · %lld already there": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld 种已存在"
          }
        }
      }
    },
    " · %lld not installable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " · %lld 种无法安装"
          }
        }
      }
    },
    "%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %lld items": {
      "comment": "Progress verb followed by the number of selected items.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$#@arg2@"
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld items"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld item"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$#@arg2@"
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 个项目"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@ (%lld of %lld)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld/%3$lld）"
          }
        }
      }
    },
    "%@ Remembered for %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已记住用于%2$@的设置。"
          }
        }
      }
    },
    "%@ Stow asks once for “%@” and remembers it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Stow 只会询问一次，并记住对“%2$@”的访问权限。"
          }
        }
      }
    },
    "%@ You can put %@ back from the Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 你可以从废纸篓中将%2$@放回原处。"
          }
        }
      }
    },
    "%@ archive": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 压缩包"
          }
        }
      }
    },
    "%@ can’t be password-protected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持密码保护"
          }
        }
      }
    },
    "%@ can’t recreate symbolic links. Choose Macs or Linux to keep them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@无法重新创建符号链接。要保留链接，请选择 Mac 或 Linux。"
          }
        }
      }
    },
    "%@ files · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 个文件 · %2$@"

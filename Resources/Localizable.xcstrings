    },
    "“%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "“%@” already exists in “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”中已有“%1$@”。"
          }
        }
      }
    },
    "“%@” and %lld more will be kept inside the destination folder instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”及另外 %2$lld 个项目将保留在目标文件夹内。"
          }
        }
      }
    },
    "“%@” and “%@” can’t sit side by side on this Mac. Both are kept; the second gets a number added.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法在同一位置存放“%1$@”和“%2$@”。两者都会保留，第二个名称会添加编号。"
          }
        }
      }
    },
    "“%@” changed while it was being packed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩过程中“%@”发生了更改。"
          }
        }
      }
    },
    "“%@” couldn’t be read from the archive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从压缩包中读取“%@”。"
          }
        }
      }
    },
    "“%@” has a broken signature": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的签名已损坏"
          }
        }
      }
    },
    "“%@” is a device file or pipe, which can’t be extracted safely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是设备文件或管道，无法安全解压缩。"
          }
        }
      }
    },
    "“%@” is already in “%@”.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%2$@”中已有“%1$@”。"
          }
        }
      }
    },
    "“%@” is already installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已安装。"
          }
        }
      }
    },
    "“%@” is from the Mac App Store": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”来自 Mac App Store"
          }
        }
      }
    },
    "“%@” is installed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已安装。"
          }
        }
      }
    },
    "“%@” is locked": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已锁定"
          }
        }
      }
    },
    "“%@” is made by Apple": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”由 Apple 制作"
          }
        }
      }
    },
    "“%@” is open. Quit it, then install again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”正在运行。请退出后重新安装。"
          }
        }
      }
    },
    "“%@” is signed and notarized": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已签名并已公证"
          }
        }
      }
    },
    "“%@” is signed with an unknown certificate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”使用未知证书签名"
          }
        }
      }
    },
    "“%@” is still being written. Open it again once it’s complete.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”仍在写入。请在写入完成后重新打开。"
          }
        }
      }
    },
    "“%@” is still downloading. Open it again once the download has finished.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”仍在下载。请在下载完成后重新打开。"
          }
        }
      }
    },
    "“%@” isn’t a font macOS can install.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 macOS 可安装的字体。"
          }
        }
      }
    },
    "“%@” isn’t notarized by Apple": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未经 Apple 公证"
          }
        }
      }
    },
    "“%@” isn’t signed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未签名"
          }
        }
      }
    },
    "“%@” isn’t signed by a known developer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”未由已知开发者签名"
          }
        }
      }
    },
    "“%@” reappeared while it was being replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换过程中，“%@”再次出现。"
          }
        }
      }
    },
    "“%@” wasn’t extracted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能解压缩“%@”。"
          }
        }
      }
    },
    "“%@” will be kept inside the destination folder instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将保留在目标文件夹内。"
          }
        }
      }
    },
    "“%@” → “%@” was left out so nothing outside the folder can be reached.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已忽略“%1$@”→“%2$@”，防止访问文件夹外部的内容。"
          }
        }
      }
    },
    "“%@” → “%@”. Links like this aren’t created when you extract.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”→“%2$@”。解压缩时不会创建此类链接。"
          }
        }
      }
    },
    "“../../.zshrc” will be kept inside the destination folder instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“../../.zshrc”将保留在目标文件夹内。"
          }
        }
      }
    },
    "“.DS_Store” and “._” files are hidden here and won’t be extracted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处已隐藏“.DS_Store”和“._”文件，解压缩时也会忽略它们。"
          }
        }
      }
    },
    "“.DS_Store”, “._” and other Finder files mean nothing on other systems.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“.DS_Store”、“._”等访达文件在其他系统上没有用途。"
          }
        }
      }
    },
    "“__MACOSX”, “.DS_Store”, “._” files, “Thumbs.db” and “desktop.ini”. Dotfiles like “.gitignore” are always kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括“__MACOSX”、“.DS_Store”、“._”文件、“Thumbs.db”和“desktop.ini”。始终保留“.gitignore”等点号文件。"
          }
        }
      }
    },
    "→ %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "→ %@"
          }
        }
      }
    },
    "≈ %@%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "≈ %1$@%2$@"
          }
        }
      }
    },
    "A rename target already exists or is inside its source." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "新名称对应的路径已存在，或位于原项目内部。"
          }
        }
      }
    },
    "A replacement folder on the archive’s volume is unavailable. Save a copy instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "无法在压缩包所在卷上创建替换目录。请改为保存副本。"
          }
        }
      }
    },
    "A staged item points outside the staging tree." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "暂存项目指向了暂存目录之外的位置。"
          }
        }
      }
    },
    "Added items must have top-level staging names." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "新增项目必须使用暂存目录中的顶层名称。"
          }
        }
      }
    },
    "An edit contains duplicate paths." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "此编辑包含重复路径。"
          }
        }
      }
    },
    "An edit path is outside the archive or is not a clean relative path." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "编辑路径超出了压缩包范围，或不是规范的相对路径。"
          }
        }
      }
    },
    "An edit refers to an entry that no longer exists." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state": "translated",
            "value": "此编辑引用了已不存在的项目。"
          }
        }
      }
    },
    "An edit would overwrite an existing path or write inside a file." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
